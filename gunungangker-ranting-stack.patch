diff --git a/src/server/Services/InventoryService.luau b/src/server/Services/InventoryService.luau
new file mode 100644
index 0000000..8949a22
--- /dev/null
+++ b/src/server/Services/InventoryService.luau
@@ -0,0 +1,216 @@
+--!strict
+--[[
+	InventoryService (SERVER) — pemilik tunggal inventory item yang bisa di-stack.
+
+	- Jumlah item disimpan di server (counts[player][itemId]). Tool di Backpack hanya presentasi:
+	  satu Tool per itemId, nama "<DisplayName> xN", Attribute Tool "ItemId" dan "Count".
+	- Jumlah juga ditulis ke Attribute Player "Item_<itemId>" (read-only untuk client; untuk HUD/quest UI).
+	- Tool di-Clone dari template di ItemConfig.TemplateFolder (mis. QuestModels/Ranting(Tool)).
+	- Tool dibangun ulang dari data server setelah respawn. Inventory TIDAK hilang saat mati (DEC-009).
+	- Tool tidak bisa di-drop (CanBeDropped = false) agar stack tidak terduplikasi.
+
+	API server:
+		InventoryService.GetCount(player, itemId) -> number
+		InventoryService.AddItem(player, itemId, amount) -> (boolean, number)   -- (berhasil, jumlah yang masuk)
+		InventoryService.RemoveItem(player, itemId, amount) -> boolean          -- atomik: semua atau tidak sama sekali
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig") :: ModuleScript) :: any
+
+local ATTR_ITEM_ID = "ItemId"
+local ATTR_COUNT = "Count"
+local PLAYER_ATTR_PREFIX = "Item_"
+
+local InventoryService = {}
+
+local counts: { [Player]: { [string]: number } } = {}
+local templates: { [string]: Tool } = {}
+local warnedMissing: { [string]: boolean } = {}
+local started = false
+
+local function isWholePositive(n: any): boolean
+	return type(n) == "number" and n == n and n > 0 and n == math.floor(n) and n < math.huge
+end
+
+-- Cari template Tool. Hasil di-cache; bila tidak ketemu, warn sekali per item.
+local function resolveTemplate(itemId: string): Tool?
+	local cached = templates[itemId]
+	if cached ~= nil and cached.Parent ~= nil then
+		return cached
+	end
+	local def = Config.Items[itemId]
+	if def == nil then
+		return nil
+	end
+
+	for _, rootName in Config.TemplateRoots do
+		local ok, root = pcall(function()
+			return game:GetService(rootName)
+		end)
+		if ok and root ~= nil then
+			local folder = root:FindFirstChild(Config.TemplateFolder)
+			local tool = folder ~= nil and folder:FindFirstChild(def.TemplateName) or nil
+			if tool ~= nil and tool:IsA("Tool") then
+				if tool.RequiresHandle and tool:FindFirstChild("Handle") == nil then
+					warn(`[InventoryService] {tool:GetFullName()} RequiresHandle=true tapi tidak punya Part "Handle"; Tool tidak bisa di-equip.`)
+				end
+				templates[itemId] = tool
+				return tool
+			end
+		end
+	end
+
+	if not warnedMissing[itemId] then
+		warnedMissing[itemId] = true
+		warn(`[InventoryService] Template Tool "{def.TemplateName}" tidak ditemukan di {Config.TemplateFolder} (dicari di: {table.concat(Config.TemplateRoots, ", ")}). Item {itemId} tidak bisa ditambahkan.`)
+	end
+	return nil
+end
+
+-- Semua Tool milik itemId (Backpack + Character). Normalnya satu.
+local function findTools(player: Player, itemId: string): { Tool }
+	local found: { Tool } = {}
+	local containers: { Instance? } = { player:FindFirstChildOfClass("Backpack"), player.Character }
+	for _, container in containers do
+		if container ~= nil then
+			for _, child in container:GetChildren() do
+				if child:IsA("Tool") and child:GetAttribute(ATTR_ITEM_ID) == itemId then
+					table.insert(found, child)
+				end
+			end
+		end
+	end
+	return found
+end
+
+-- Samakan Tool dengan data server. Idempoten: aman dipanggil berulang.
+local function syncTool(player: Player, itemId: string)
+	local inv = counts[player]
+	local def = Config.Items[itemId]
+	if inv == nil or def == nil then
+		return
+	end
+	local count = inv[itemId] or 0
+	player:SetAttribute(PLAYER_ATTR_PREFIX .. itemId, count)
+
+	local tools = findTools(player, itemId)
+	-- Buang duplikat (jaga-jaga); sisakan satu.
+	for i = 2, #tools do
+		tools[i]:Destroy()
+	end
+	local tool: Tool? = tools[1]
+
+	if count <= 0 then
+		if tool ~= nil then
+			tool:Destroy()
+		end
+		return
+	end
+
+	if tool == nil then
+		local backpack = player:FindFirstChildOfClass("Backpack")
+		local template = resolveTemplate(itemId)
+		if backpack == nil or template == nil then
+			return -- dibangun ulang saat Backpack tersedia
+		end
+		local clone = template:Clone()
+		clone.CanBeDropped = false
+		clone:SetAttribute(ATTR_ITEM_ID, itemId)
+		clone.Parent = backpack
+		tool = clone
+	end
+
+	local label = `{def.DisplayName} x{count}`
+	local t = tool :: Tool
+	t:SetAttribute(ATTR_COUNT, count)
+	t.Name = label
+	t.ToolTip = label
+end
+
+local function syncAll(player: Player)
+	local inv = counts[player]
+	if inv == nil then
+		return
+	end
+	for itemId in Config.Items do
+		syncTool(player, itemId)
+	end
+end
+
+function InventoryService.GetCount(player: Player, itemId: string): number
+	local inv = counts[player]
+	return if inv ~= nil then (inv[itemId] or 0) else 0
+end
+
+function InventoryService.AddItem(player: Player, itemId: string, amount: number): (boolean, number)
+	local def = Config.Items[itemId]
+	local inv = counts[player]
+	if def == nil or inv == nil or not isWholePositive(amount) then
+		return false, 0
+	end
+	local room = def.MaxStack - (inv[itemId] or 0)
+	if room <= 0 then
+		return false, 0 -- stack penuh
+	end
+	-- Template wajib ada: tanpa Tool, pemain tidak melihat item dan resource akan "hilang".
+	if resolveTemplate(itemId) == nil then
+		return false, 0
+	end
+	local added = math.min(room, amount)
+	inv[itemId] = (inv[itemId] or 0) + added
+	syncTool(player, itemId)
+	return true, added
+end
+
+function InventoryService.RemoveItem(player: Player, itemId: string, amount: number): boolean
+	local inv = counts[player]
+	if Config.Items[itemId] == nil or inv == nil or not isWholePositive(amount) then
+		return false
+	end
+	local have = inv[itemId] or 0
+	if have < amount then
+		return false
+	end
+	inv[itemId] = have - amount
+	syncTool(player, itemId)
+	return true
+end
+
+local function onPlayerAdded(player: Player)
+	if counts[player] ~= nil then
+		return
+	end
+	counts[player] = {}
+	for itemId in Config.Items do
+		player:SetAttribute(PLAYER_ATTR_PREFIX .. itemId, 0)
+	end
+	-- Backpack bisa dibuat ulang saat respawn; bangun ulang Tool dari data server.
+	player.ChildAdded:Connect(function(child: Instance)
+		if child:IsA("Backpack") then
+			syncAll(player)
+		end
+	end)
+	player.CharacterAdded:Connect(function()
+		task.defer(syncAll, player)
+	end)
+end
+
+function InventoryService.Start()
+	if started then
+		return
+	end
+	started = true
+
+	Players.PlayerAdded:Connect(onPlayerAdded)
+	Players.PlayerRemoving:Connect(function(player: Player)
+		counts[player] = nil
+	end)
+	for _, player in Players:GetPlayers() do
+		onPlayerAdded(player)
+	end
+end
+
+return InventoryService
diff --git a/src/server/Services/PickupService.luau b/src/server/Services/PickupService.luau
new file mode 100644
index 0000000..bf1bd7e
--- /dev/null
+++ b/src/server/Services/PickupService.luau
@@ -0,0 +1,222 @@
+--!strict
+--[[
+	PickupService (SERVER) — mengambil item dunia (mis. ranting) lewat ProximityPrompt -> InventoryService.
+
+	Cara memasang di Studio (tanpa mengubah script):
+	  1. Beri CollectionService tag sesuai ItemConfig.Items[id].PickupTag (default "Ranting")
+	     pada Model/Part ranting di dunia.
+	  2. Jika objek sudah punya ProximityPrompt (di dalamnya), prompt itu dipakai apa adanya.
+	     Jika belum, server membuatkan satu (tanpa membuat Part/aset).
+
+	Validasi server: tag masih terpasang, karakter hidup, jarak ke prompt, cooldown per pemain per
+	objek, dan stack belum penuh (InventoryService menolak bila penuh; objek tetap utuh).
+	Client hanya mengirim intent lewat prompt; tidak pernah mengirim hasil.
+
+	CATATAN (DEC-010): objek TIDAK dihapus/disembunyikan. Ketersediaan resource personal,
+	pool spawn, dan respawn dikerjakan ResourceSystem nanti; sementara ini PickupCooldown
+	mencegah ambil berulang dari objek yang sama.
+]]
+
+local CollectionService = game:GetService("CollectionService")
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemConfig") :: ModuleScript) :: any
+local InventoryService = require((script.Parent :: Instance):WaitForChild("InventoryService") :: ModuleScript) :: any
+
+local PickupService = {}
+
+type Binding = {
+	Prompt: ProximityPrompt,
+	CreatedPrompt: boolean,
+	Connection: RBXScriptConnection,
+}
+
+-- bindings[itemId][instance]
+local bindings: { [string]: { [Instance]: Binding } } = {}
+-- lastTake[player][instance] = os.clock() terakhir berhasil (key lemah agar objek yang dihapus tidak bocor).
+local lastTake: { [Player]: { [Instance]: number } } = {}
+local started = false
+
+local function getPromptPosition(prompt: ProximityPrompt): Vector3?
+	local parent = prompt.Parent
+	if parent == nil then
+		return nil
+	end
+	if parent:IsA("BasePart") then
+		return parent.Position
+	elseif parent:IsA("Attachment") then
+		return parent.WorldPosition
+	elseif parent:IsA("Model") then
+		return parent:GetPivot().Position
+	end
+	return nil
+end
+
+local function getAliveRoot(player: Player): BasePart?
+	local character = player.Character
+	if character == nil then
+		return nil
+	end
+	local humanoid = character:FindFirstChildOfClass("Humanoid")
+	if humanoid == nil or humanoid.Health <= 0 then
+		return nil
+	end
+	local root = character:FindFirstChild("HumanoidRootPart")
+	if root ~= nil and root:IsA("BasePart") then
+		return root
+	end
+	return nil
+end
+
+local function onTriggered(instance: Instance, itemId: string, def: any, binding: Binding, player: Player)
+	if instance.Parent == nil or not CollectionService:HasTag(instance, def.PickupTag) then
+		return
+	end
+
+	local root = getAliveRoot(player)
+	if root == nil then
+		return
+	end
+	local promptPosition = getPromptPosition(binding.Prompt)
+	if promptPosition == nil then
+		return
+	end
+	local maxDistance = binding.Prompt.MaxActivationDistance + Config.PickupDistanceTolerance
+	if (root.Position - promptPosition).Magnitude > maxDistance then
+		return
+	end
+
+	local playerTakes = lastTake[player]
+	if playerTakes == nil then
+		return -- pemain sudah keluar
+	end
+	local now = os.clock()
+	local last = playerTakes[instance]
+	if last ~= nil and now - last < def.PickupCooldown then
+		return
+	end
+
+	-- Stack penuh / template hilang: ditolak, objek tetap utuh. (Notifikasi ke pemain menunggu Remote Phase 1.)
+	local ok = InventoryService.AddItem(player, itemId, def.PickupAmount)
+	if ok then
+		playerTakes[instance] = now
+	end
+end
+
+local function findOrCreatePrompt(instance: Instance, def: any): (ProximityPrompt?, boolean)
+	if instance:IsA("ProximityPrompt") then
+		return instance, false
+	end
+	local existing = instance:FindFirstChildWhichIsA("ProximityPrompt", true)
+	if existing ~= nil then
+		return existing, false
+	end
+
+	local host: Instance? = nil
+	if instance:IsA("BasePart") then
+		host = instance
+	elseif instance:IsA("Model") then
+		host = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
+	end
+	if host == nil then
+		return nil, false
+	end
+
+	local prompt = Instance.new("ProximityPrompt")
+	prompt.Name = "PickupPrompt"
+	prompt.ActionText = def.ActionText
+	prompt.ObjectText = instance.Name
+	prompt.HoldDuration = 0
+	prompt.RequiresLineOfSight = false
+	prompt.MaxActivationDistance = Config.PickupPromptDistance
+	prompt.Parent = host
+	return prompt, true
+end
+
+local function bind(itemId: string, def: any, instance: Instance)
+	local itemBindings = bindings[itemId]
+	if itemBindings[instance] ~= nil then
+		return
+	end
+	local prompt, created = findOrCreatePrompt(instance, def)
+	if prompt == nil then
+		warn(`[PickupService] {instance:GetFullName()} ber-tag {def.PickupTag} tapi tidak punya ProximityPrompt dan bukan Model/Part; dilewati.`)
+		return
+	end
+
+	local binding: Binding = {
+		Prompt = prompt,
+		CreatedPrompt = created,
+		Connection = (nil :: any),
+	}
+	binding.Connection = prompt.Triggered:Connect(function(player: Player)
+		onTriggered(instance, itemId, def, binding, player)
+	end)
+	itemBindings[instance] = binding
+end
+
+local function unbind(itemId: string, instance: Instance)
+	local binding = bindings[itemId][instance]
+	if binding == nil then
+		return
+	end
+	bindings[itemId][instance] = nil
+	binding.Connection:Disconnect()
+	if binding.CreatedPrompt then
+		binding.Prompt:Destroy()
+	end
+end
+
+local function validateDef(itemId: string, def: any): boolean
+	if type(def.PickupTag) ~= "string" or def.PickupTag == "" then
+		warn(`[PickupService] Config {itemId}: PickupTag tidak valid.`)
+		return false
+	end
+	if type(def.PickupAmount) ~= "number" or def.PickupAmount <= 0 or def.PickupAmount ~= math.floor(def.PickupAmount) then
+		warn(`[PickupService] Config {itemId}: PickupAmount harus bilangan bulat > 0.`)
+		return false
+	end
+	if type(def.PickupCooldown) ~= "number" or def.PickupCooldown < 0 then
+		warn(`[PickupService] Config {itemId}: PickupCooldown harus >= 0.`)
+		return false
+	end
+	return true
+end
+
+local function trackPlayer(player: Player)
+	lastTake[player] = setmetatable({}, { __mode = "k" }) :: any
+end
+
+function PickupService.Start()
+	if started then
+		return
+	end
+	started = true
+
+	Players.PlayerAdded:Connect(trackPlayer)
+	Players.PlayerRemoving:Connect(function(player: Player)
+		lastTake[player] = nil
+	end)
+	for _, player in Players:GetPlayers() do
+		trackPlayer(player)
+	end
+
+	for itemId, def in Config.Items do
+		if not validateDef(itemId, def) then
+			continue
+		end
+		bindings[itemId] = {}
+		for _, instance in CollectionService:GetTagged(def.PickupTag) do
+			bind(itemId, def, instance)
+		end
+		CollectionService:GetInstanceAddedSignal(def.PickupTag):Connect(function(instance: Instance)
+			bind(itemId, def, instance)
+		end)
+		CollectionService:GetInstanceRemovedSignal(def.PickupTag):Connect(function(instance: Instance)
+			unbind(itemId, instance)
+		end)
+	end
+end
+
+return PickupService
