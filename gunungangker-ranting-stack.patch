+--!strict
+--[[
+	ItemConfig — definisi item yang bisa ditumpuk (stack) di backpack (dibaca server DAN client).
+
+	Satu item = SATU Tool di Backpack, berapa pun jumlahnya. Jumlah asli disimpan server
+	(InventoryService); Tool hanya presentasi. Ubah angka di sini untuk balancing.
+
+	TemplateFolder / TemplateRoots : tempat folder template Tool dicari (urut). Lokasi pasti
+	                                 folder "QuestModels" belum diverifikasi di Studio; setelah
+	                                 diketahui, sisakan satu root saja.
+	Items[id]:
+	  DisplayName    : nama di hotbar/backpack (ditambah " xN").
+	  TemplateName   : nama Tool di dalam TemplateFolder (yang di-Clone untuk pemain).
+	  MaxStack       : jumlah maksimum per pemain. Penuh = pickup ditolak.
+	  PickupTag      : CollectionService tag untuk objek dunia yang bisa diambil.
+	  PickupAmount   : jumlah per interaksi.
+	  PickupCooldown : detik jeda ambil ulang objek yang SAMA, per pemain (pengganti sementara
+	                   "respawn 3 dtk" GDD sampai ResourceSystem ada, lihat DEC-010).
+	  ActionText     : teks ProximityPrompt (hanya jika server membuat prompt sendiri).
+]]
+
+export type ItemDef = {
+	DisplayName: string,
+	TemplateName: string,
+	MaxStack: number,
+	PickupTag: string,
+	PickupAmount: number,
+	PickupCooldown: number,
+	ActionText: string,
+}
+
+export type Config = {
+	TemplateFolder: string,
+	TemplateRoots: { string },
+	PickupDistanceTolerance: number,
+	PickupPromptDistance: number,
+	Items: { [string]: ItemDef },
+}
+
+local Config: Config = {
+	TemplateFolder = "QuestModels",
+	TemplateRoots = { "ServerStorage", "ReplicatedStorage", "Workspace" },
+
+	-- Toleransi jarak (stud) di atas MaxActivationDistance prompt untuk validasi server.
+	PickupDistanceTolerance = 6,
+	-- MaxActivationDistance untuk prompt yang dibuat server.
+	PickupPromptDistance = 8,
+
+	Items = {
+		Ranting = {
+			DisplayName = "Ranting",
+			TemplateName = "Ranting(Tool)",
+			MaxStack = 20, -- GDD: CP1 butuh 10; angka ini perlu konfirmasi (Q6)
+			PickupTag = "Ranting",
+			PickupAmount = 1,
+			PickupCooldown = 3,
+			ActionText = "Ambil",
+		},
+	},
+}
+
+return Config
