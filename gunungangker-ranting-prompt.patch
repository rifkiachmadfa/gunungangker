+-- Intent dari client (mode Prompt). Semua argumen tidak dipercaya.
+local function onCollectRequest(player: Player, setId: unknown, pointName: unknown)
+	if type(setId) ~= "string" or type(pointName) ~= "string" or #pointName > 64 then
+		return
+	end
+
+	local now = os.clock()
+	local last = lastCollectRequest[player]
+	if last == nil then
+		return -- pemain sudah keluar
+	end
+	if now - last < Config.CollectInterval then
+		return
+	end
+	lastCollectRequest[player] = now
+
+	local def = Config.Sets[setId]
+	if def == nil or def.PickupMode ~= "Prompt" then
+		return
+	end
+	local sets = playerSets[player]
+	local state = if sets ~= nil then sets[setId] else nil
+	if state == nil or not state.Active[pointName] then
+		return -- set tidak aktif untuk pemain ini (belum menerima quest / sudah selesai) atau titik tidak aktif
+	end
+	local pool = pools[setId]
+	local part = if pool ~= nil then pool.ByName[pointName] else nil
+	if part == nil or part.Parent == nil then
+		return
+	end
+	local root = Interaction.GetAliveRoot(player)
+	if root == nil then
+		return
+	end
+
+	local delta = root.Position - part.Position
+	local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
+	if horizontal > def.PromptDistance + Config.PromptTolerance or math.abs(delta.Y) > def.VerticalTolerance then
+		return
+	end
+
+	collect(player, setId, def, state, pointName)
+end
+
